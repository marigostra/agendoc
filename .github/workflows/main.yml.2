name: Build native Agendoc

on:
  push:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build-linux:
    name: Build Linux native binary
    runs-on: ubuntu-22.04

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Linux build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            build-essential \
            libasound2-dev \
            libavcodec-dev \
            libavformat-dev \
            libavutil-dev \
            libfreetype6-dev \
            libgl-dev \
            libgtk-3-dev \
            libpango1.0-dev \
            libx11-dev \
            libxext-dev \
            libxi-dev \
            libxrender-dev \
            libxtst-dev \
            zlib1g-dev

      - name: Set up Gluon GraalVM for Java 17
        run: |
          GRAALVM_VERSION="17.0.12"
          GRAALVM_ARCHIVE="graalvm-java17-linux-amd64-${GRAALVM_VERSION}.tar.gz"
          GRAALVM_URL="https://github.com/gluonhq/graal/releases/download/gluon-${GRAALVM_VERSION}/${GRAALVM_ARCHIVE}"

          mkdir -p "$HOME/gluon-graalvm"
          curl -L \
            --retry 3 \
            --retry-delay 5 \
            --fail \
            -o "$HOME/gluon-graalvm/${GRAALVM_ARCHIVE}" \
            "$GRAALVM_URL"

          tar -xzf "$HOME/gluon-graalvm/${GRAALVM_ARCHIVE}" -C "$HOME/gluon-graalvm"

          GLUON_GRAALVM_HOME="$(find "$HOME/gluon-graalvm" -maxdepth 2 -type d -name 'graalvm-*' | head -n 1)"

          if [ -z "$GLUON_GRAALVM_HOME" ]; then
            echo "Gluon GraalVM directory was not found."
            exit 1
          fi

          echo "GRAALVM_HOME=$GLUON_GRAALVM_HOME" >> "$GITHUB_ENV"
          echo "JAVA_HOME=$GLUON_GRAALVM_HOME" >> "$GITHUB_ENV"
          echo "$GLUON_GRAALVM_HOME/bin" >> "$GITHUB_PATH"

          "$GLUON_GRAALVM_HOME/bin/java" -version
          "$GLUON_GRAALVM_HOME/bin/native-image" --version

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Make Gradle wrapper executable
        run: chmod +x ./gradlew

      - name: Build Linux native application
        run: ./gradlew nativeBuild --stacktrace

      - name: Collect Linux binary
        shell: bash
        run: |
          mkdir -p dist

          BINARY="$(find build/gluonfx \
            -type f \
            -name 'agendoc' \
            -perm /111 \
            ! -path '*/gvm/*' \
            | head -n 1)"

          if [ -z "$BINARY" ]; then
            echo "Native Linux binary was not found."
            find build -type f | sort
            exit 1
          fi

          cp "$BINARY" dist/agendoc-linux-x64
          chmod +x dist/agendoc-linux-x64

          file dist/agendoc-linux-x64
          ls -la dist

      - name: Upload Linux artifact
        uses: actions/upload-artifact@v4
        with:
          name: agendoc-linux-x64
          path: dist/agendoc-linux-x64
          if-no-files-found: error
          retention-days: 30

  build-windows:
    name: Build Windows native executable
    runs-on: windows-2022

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Visual Studio build environment
        uses: ilammy/msvc-dev-cmd@v1
        with:
          arch: x64

      - name: Set up GraalVM for Java 17
        uses: graalvm/setup-graalvm@v1
        with:
          java-version: "17"
          distribution: "graalvm"
          github-token: ${{ secrets.GITHUB_TOKEN }}
          native-image-job-reports: "false"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Build Windows native application
        shell: pwsh
        run: |
          .\gradlew.bat nativeBuild --stacktrace

      - name: Collect Windows executable
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force -Path dist | Out-Null

          $binary = Get-ChildItem `
            -Path build\gluonfx `
            -Recurse `
            -File `
            -Filter agendoc.exe |
            Select-Object -First 1

          if ($null -eq $binary) {
              Write-Error "Native Windows executable was not found."

              Get-ChildItem `
                -Path build `
                -Recurse `
                -File |
                Select-Object -ExpandProperty FullName

              exit 1
          }

          Copy-Item `
            -Path $binary.FullName `
            -Destination dist\agendoc-windows-x64.exe

          Get-ChildItem dist

      - name: Upload Windows artifact
        uses: actions/upload-artifact@v4
        with:
          name: agendoc-windows-x64
          path: dist/agendoc-windows-x64.exe
          if-no-files-found: error
          retention-days: 30

  release:
    name: Create GitHub Release
    if: startsWith(github.ref, 'refs/tags/')
    needs:
      - build-linux
      - build-windows
    runs-on: ubuntu-22.04

    steps:
      - name: Download native artifacts
        uses: actions/download-artifact@v4
        with:
          pattern: agendoc-*
          path: release
          merge-multiple: true

      - name: Show release files
        run: |
          chmod +x release/agendoc-linux-x64
          ls -la release
          file release/*

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          files: |
            release/agendoc-linux-x64
            release/agendoc-windows-x64.exe
          generate_release_notes: true
          fail_on_unmatched_files: true
